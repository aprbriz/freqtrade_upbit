# collector.py
import json
import time
import signal
import websocket
import logging

from ohlcv_writer import OHLCVWriter
from multi_aggregator import MultiAggregator


logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("collector")

UPBIT_WS_URL = "wss://api.upbit.com/websocket/v1"
PAIRS = ["KRW-BTC", "KRW-ETH"]
MAX_LATE_MS = 2000


class UpbitCollector:
    def __init__(self):
        self.writer = OHLCVWriter()
        self.aggregator = MultiAggregator(self.writer)
        self.running = True

    def on_open(self, ws):
        logger.info("WebSocket connected")

        ws.send(json.dumps([
            {"ticket": "upbit-collector"},
            {
                "type": "trade",
                "codes": PAIRS,
                "isOnlyRealtime": True,
            }
        ]))

    def on_message(self, ws, message):
        data = json.loads(message)

        # [REQ] symbol → pair 명칭 통일
        pair = data["code"]
        price = data["trade_price"]
        volume = data["trade_volume"]
        ts_ms = data["trade_timestamp"]

        self.aggregator.update(pair, price, volume, ts_ms)

    def run(self):
        ws = websocket.WebSocketApp(
            UPBIT_WS_URL,
            on_open=self.on_open,
            on_message=self.on_message,
        )

        while self.running:
            ws.run_forever(ping_interval=60)
            time.sleep(1)

    def stop(self):
        logger.info("Stopping...")
        self.running = False
        self.aggregator.shutdown()


def main():
    collector = UpbitCollector()

    def shutdown(sig, frame):
        collector.stop()

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    collector.run()


if __name__ == "__main__":
    main()
