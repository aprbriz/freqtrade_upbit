# tick_aggregator.py
import threading
from collections import defaultdict


class TickAggregator:
    """
    틱 기반 봉 생성기 (예: 3틱봉)
    """

    def __init__(self, tick_size: int, writer):
        self.tick_size = tick_size
        self.writer = writer

        self.current = defaultdict(dict)
        self.lock = threading.Lock()

    def update(self, pair: str, price: float, volume: float, ts_ms: int):
        """
        체결 데이터 1건 처리
        """
        with self.lock:
            candle = self.current.get(pair)

            if not candle:
                self.current[pair] = {
                    "count": 1,
                    "open": price,
                    "high": price,
                    "low": price,
                    "close": price,
                    "volume": volume,
                    "start_ts": ts_ms,
                }
                return

            candle["count"] += 1
            candle["high"] = max(candle["high"], price)
            candle["low"] = min(candle["low"], price)
            candle["close"] = price
            candle["volume"] += volume

            if candle["count"] >= self.tick_size:
                self.writer.write(
                    pair=pair,
                    ts=candle["start_ts"],
                    timeframe_ms=-self.tick_size,  # 틱봉은 음수
                    candle=candle,
                )
                self.current.pop(pair, None)

    def flush_all(self):
        """
        종료 시 남은 틱봉 강제 저장
        """
        with self.lock:
            for pair, candle in self.current.items():
                self.writer.write(
                    pair=pair,
                    ts=candle["start_ts"],
                    timeframe_ms=-self.tick_size,
                    candle=candle,
                )
            self.current.clear()
