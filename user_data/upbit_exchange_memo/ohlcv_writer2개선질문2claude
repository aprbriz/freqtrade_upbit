# ohlcv_writer.py
import sqlite3
import threading
import time
from pathlib import Path
import logging


logger = logging.getLogger("ohlcv-writer")


class OHLCVWriter:
    """
    OHLCV 데이터를 SQLite DB에 저장하는 클래스

    - pair 별 테이블 사용
    - PRIMARY KEY (ts)
    - 0.5초봉, 1초봉 등은 timeframe_ms 컬럼으로 구분
    """

    def __init__(self):
        # DB 파일 위치
        self.db_path = Path(__file__).resolve().parent / "ohlcv.sqlite"

        # SQLite는 멀티스레드에 약하므로 Lock 사용
        self.lock = threading.Lock()

        # DB 초기화
        self._init_db()

    # =========================================================
    # DB 초기화
    # =========================================================
    def _init_db(self):
        """
        DB 파일 및 기본 설정 초기화
        """
        self.db_path.parent.mkdir(parents=True, exist_ok=True)

        with self._connect() as conn:
            # SQLite 성능 튜닝 옵션
            conn.execute("PRAGMA journal_mode=WAL;")
            conn.execute("PRAGMA synchronous=NORMAL;")
            conn.execute("PRAGMA temp_store=MEMORY;")

    def _connect(self):
        """
        SQLite 연결 생성
        """
        return sqlite3.connect(
            self.db_path,
            check_same_thread=False
        )

    # =========================================================
    # 테이블 관련
    # =========================================================
    def _table_name(self, pair: str) -> str:
        """
        pair 이름을 테이블 이름으로 변환

        예)
        KRW-BTC → ohlcv_KRW_BTC
        """
        # [REQ] symbol → pair 명칭 통일
        return f"ohlcv_{pair.replace('-', '_')}"

    def _create_table_if_not_exists(self, conn, table: str):
        """
        pair별 테이블 생성
        """
        sql = f"""
        CREATE TABLE IF NOT EXISTS {table} (
            ts INTEGER PRIMARY KEY,
            open REAL NOT NULL,
            high REAL NOT NULL,
            low REAL NOT NULL,
            close REAL NOT NULL,
            volume REAL NOT NULL,
            timeframe_ms INTEGER NOT NULL
        );
        """
        conn.execute(sql)

        # ts + timeframe 조회 성능용 인덱스
        conn.execute(
            f"CREATE INDEX IF NOT EXISTS idx_{table}_tf "
            f"ON {table}(timeframe_ms);"
        )

    # =========================================================
    # 데이터 저장
    # =========================================================
    def write(self, pair: str, ts: int, timeframe_ms: int, candle: dict):
        """
        OHLCV 1건 저장

        candle 예:
        {
            open: float,
            high: float,
            low: float,
            close: float,
            volume: float
        }
        """
        table = self._table_name(pair)

        with self.lock:
            with self._connect() as conn:
                self._create_table_if_not_exists(conn, table)

                sql = f"""
                INSERT OR REPLACE INTO {table}
                (ts, open, high, low, close, volume, timeframe_ms)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                """

                conn.execute(
                    sql,
                    (
                        ts,
                        candle["open"],
                        candle["high"],
                        candle["low"],
                        candle["close"],
                        candle["volume"],
                        timeframe_ms,
                    )
                )

                conn.commit()

    # =========================================================
    # 오래된 데이터 정리
    # =========================================================
    def cleanup_old_data(self, days: int = 365):
        """
        오래된 데이터 삭제

        - days 이전 데이터 삭제
        - 현재는 하드코딩
        """
        cutoff_ts = int(
            (time.time() - days * 86400) * 1000
        )

        with self.lock:
            with self._connect() as conn:
                cursor = conn.cursor()

                # 모든 테이블 조회
                cursor.execute("""
                    SELECT name
                    FROM sqlite_master
                    WHERE type='table'
                      AND name LIKE 'ohlcv_%'
                """)

                tables = [row[0] for row in cursor.fetchall()]

                for table in tables:
                    logger.info(
                        f"Cleaning old data: {table}, before {cutoff_ts}"
                    )

                    conn.execute(
                        f"DELETE FROM {table} WHERE ts < ?",
                        (cutoff_ts,)
                    )

                conn.commit()
