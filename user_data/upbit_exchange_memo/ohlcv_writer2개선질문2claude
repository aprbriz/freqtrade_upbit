# pragma pylint: disable=missing-docstring, invalid-name

import sqlite3
from pathlib import Path
import pandas as pd

from freqtrade.strategy import IStrategy
from pandas import DataFrame


class UpbitMicroStructureStrategy(IStrategy):
    """
    업비트 초단기(0.5초 / 1초 / 3틱봉) 데이터를
    직접 SQLite에서 읽어 사용하는 Strategy
    """

    # =====================================================
    # freqtrade 기본 설정
    # =====================================================

    # freqtrade에게는 "형식상" 타임프레임만 제공
    timeframe = "1m"

    # 초단기 전략이므로 ROI, 손절은 Strategy에서 직접 제어
    minimal_roi = {"0": 0.01}
    stoploss = -0.02

    process_only_new_candles = True
    startup_candle_count = 1

    # =====================================================
    # DB 관련 설정
    # =====================================================

    DB_PATH = Path(__file__).resolve().parents[1] / "upbit_exchange" / "ohlcv.sqlite"

    # =====================================================
    # 공통 유틸 함수
    # =====================================================
    def _load_ohlcv(
        self,
        pair: str,
        timeframe_ms: int,
        limit: int = 200
    ) -> DataFrame:
        """
        SQLite에서 특정 pair + timeframe 데이터를 읽어오는 함수

        timeframe_ms:
        - 500   → 0.5초봉
        - 1000  → 1초봉
        - -3    → 3틱봉
        """

        # [REQ] symbol → pair 명칭 통일
        # freqtrade pair: ETH/KRW
        # DB table name : ohlcv_KRW_ETH

        base, quote = pair.replace('-', '/').split('/')
        table = f"ohlcv_{quote}_{base}"


        sql = f"""
        SELECT
            ts,
            open,
            high,
            low,
            close,
            volume
        FROM {table}
        WHERE timeframe_ms = ?
        ORDER BY ts DESC
        LIMIT ?
        """

        with sqlite3.connect(self.DB_PATH) as conn:
            df = pd.read_sql(
                sql,
                conn,
                params=(timeframe_ms, limit),
            )

        # ts(ms)를 pandas datetime으로 변환
        df["date"] = pd.to_datetime(df["ts"], unit="ms")

        # 시간 순 정렬 (중요!)
        df = df.sort_values("ts").reset_index(drop=True)

        return df

    # =====================================================
    # Indicator 생성
    # =====================================================
    def populate_indicators(
        self,
        dataframe: DataFrame,
        metadata: dict
    ) -> DataFrame:
        """
        freqtrade가 주기적으로 호출하는 함수

        여기서 우리가 만든 초단기 데이터를 직접 읽는다
        """

        # 🔒 컬럼 기본값 초기화 (중요)
        dataframe["mom_500ms"] = 0.0
        dataframe["range_1s"] = 0.0
        dataframe["vol_3tick"] = 0.0

        pair = metadata["pair"]

        # -------------------------------------------------
        # 0.5초봉 로드
        # -------------------------------------------------
        df_500ms = self._load_ohlcv(
            pair=pair,
            timeframe_ms=500,
            limit=120
        )

        # -------------------------------------------------
        # 1초봉 로드
        # -------------------------------------------------
        df_1s = self._load_ohlcv(
            pair=pair,
            timeframe_ms=1000,
            limit=120
        )

        # -------------------------------------------------
        # 3틱봉 로드
        # -------------------------------------------------
        df_3tick = self._load_ohlcv(
            pair=pair,
            timeframe_ms=-3,
            limit=120
        )

        # -------------------------------------------------
        # 예제 Indicator (초보자용)
        # -------------------------------------------------

        # 0.5초봉 기준 단기 모멘텀
        df_500ms["momentum"] = (
            df_500ms["close"] - df_500ms["open"]
        )

        # 1초봉 기준 변동성
        df_1s["range"] = (
            df_1s["high"] - df_1s["low"]
        )

        # 3틱봉 기준 거래량 누적
        df_3tick["vol_ma"] = (
            df_3tick["volume"].rolling(5).mean()
        )

        # -------------------------------------------------
        # 최신 값만 freqtrade dataframe에 전달
        # -------------------------------------------------
        if not df_500ms.empty:
            dataframe.loc[:, "mom_500ms"] = df_500ms.iloc[-1]["momentum"]

        if not df_1s.empty:
            dataframe.loc[:, "range_1s"] = df_1s.iloc[-1]["range"]

        if not df_3tick.empty:
            dataframe.loc[:, "vol_3tick"] = df_3tick.iloc[-1]["vol_ma"]

        return dataframe

    # =====================================================
    # 진입 조건
    # =====================================================
    def populate_entry_trend(
        self,
        dataframe: DataFrame,
        metadata: dict
    ) -> DataFrame:
        """
        매수(진입) 조건
        """

        dataframe.loc[
            (
                # 0.5초봉 모멘텀이 양수
                (dataframe["mom_500ms"] > 0)
                &
                # 1초봉 변동성이 충분히 있음
                (dataframe["range_1s"] > dataframe["range_1s"].rolling(10).mean())
                &
                # 3틱봉 거래량 증가
                (dataframe["vol_3tick"] > dataframe["vol_3tick"].rolling(10).mean())
            ),
            "enter_long"
        ] = 1

        return dataframe

    # =====================================================
    # 청산 조건
    # =====================================================
    def populate_exit_trend(
        self,
        dataframe: DataFrame,
        metadata: dict
    ) -> DataFrame:
        """
        매도(청산) 조건
        """

        dataframe.loc[
            (
                # 모멘텀 꺾이면 바로 청산
                (dataframe["mom_500ms"] < 0)
            ),
            "exit_long"
        ] = 1

        return dataframe



    def _load_ohlcv(
        self,
        pair: str,
        timeframe_ms: int,
        limit: int = 200
    ) -> DataFrame:

        # freqtrade pair: ETH/KRW
        # DB table: ohlcv_KRW_ETH
        base, quote = pair.replace('-', '/').split('/')
        table = f"ohlcv_{quote}_{base}"

        with sqlite3.connect(self.DB_PATH) as conn:
            # 1️⃣ 테이블 존재 여부 체크
            check_sql = """
            SELECT name FROM sqlite_master
            WHERE type='table' AND name=?
            """
            if not conn.execute(check_sql, (table,)).fetchone():
                return pd.DataFrame()

            # 2️⃣ 실제 데이터 로드
            sql = f"""
            SELECT
                ts,
                open,
                high,
                low,
                close,
                volume
            FROM {table}
            WHERE timeframe_ms = ?
            ORDER BY ts DESC
            LIMIT ?
            """

            df = pd.read_sql_query(
                sql,
                conn,
                params=(timeframe_ms, limit),
            )

        if df.empty:
            return df

        df["date"] = pd.to_datetime(df["ts"], unit="ms")
        df = df.sort_values("ts").reset_index(drop=True)

        return df
