{
    "$schema": "https://schema.freqtrade.io",

    "_comment_general": "Upbit 기준 최소/안전 설정. Binance 잔재 제거 목적",

    "max_open_trades": 3,

    "stake_currency": "KRW",
    "stake_amount": 50000,
    "_comment_stake_amount": "Upbit는 최소 주문금액 제약이 강하므로 5만원 단위 유지",

    "tradable_balance_ratio": 0.95,
    "_comment_tradable_balance_ratio": "수수료/슬리피지/체결 실패 대비로 0.99 → 0.95 완화",

    "fiat_display_currency": "KRW",

    "dry_run": true,
    "dry_run_wallet": 200000,
    "_comment_dry_run": "Upbit 구조 검증 단계이므로 실거래 절대 금지",

    "cancel_open_orders_on_exit": true,
    "_comment_cancel_open_orders_on_exit": "Upbit 주문 잔존 리스크 방지",

    "trading_mode": "spot",
    "margin_mode": "",

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "_comment_use_order_book": "Upbit는 ccxt orderbook 신뢰도 낮아 비활성화",
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "_comment_exit_pricing": "진입/청산 로직 단순화 (Upbit 대응용)"
    },

    "exchange": {
        "name": "upbit",
        "key": "YOUR_UPBIT_ACCESS_KEY",
        "secret": "YOUR_UPBIT_SECRET_KEY",

        "enable_ws": false,
        "_comment_enable_ws": "Upbit는 websocket OHLCV 미지원 → REST 기반 유지",

        "pair_whitelist": [
            "BTC/KRW",
            "ETH/KRW",
            "XRP/KRW"
        ],

        "_comment_pair_whitelist": "VolumePairList와 동시에 쓰면 충돌 가능. Upbit는 고정 마켓 권장",

        "pair_blacklist": [
            "BTT/KRW"
        ],

        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "defaultType": "spot"
            }
        },

        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 200,
            "_comment_rateLimit": "Upbit REST rate limit 보수적으로 상향"
        }
    },

    "internals": {
        "process_throttle_secs": 5,
        "_comment_process_throttle_secs": "Upbit API 보호 목적 (1초 → 5초)"
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
     ],

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "api_server": {
        "enabled": false,
        "_comment_api_server": "Upbit 포크 이후 UI 수정 예정이므로 현재 비활성화",

        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,

        "jwt_secret_key": "CHANGE_ME",
        "ws_token": "CHANGE_ME",

        "CORS_origins": [],
        "username": "opc",
        "password": "1111"
    },

    "bot_name": "freqtrade_upbit",
    "initial_state": "running",
    "force_entry_enable": false
}

